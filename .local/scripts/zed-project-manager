#!/usr/bin/env bash
set -uo pipefail

PROJECT_DIR="$HOME/GitHub"
MAX_DEPTH="${MAX_DEPTH:-3}"

SELECTED=$(
    find "$PROJECT_DIR" -mindepth 1 -maxdepth "$MAX_DEPTH" -type d \
        -exec test -e "{}/.git" \; \
        -print \
        -prune 2>/dev/null |
    while IFS= read -r path; do
        repo_name="${path##*/}"
        printf '%s\t%s\n' "$repo_name" "$path"
    done |
    sort -t $'\t' -k1,1 -k2,2 |
    awk -F '\t' '
        {
            rows[NR] = $0
            if (length($1) > max) max = length($1) + 1
        }
        END {
            for (i = 1; i <= NR; i++) {
                split(rows[i], parts, "\t")
                printf "%-*s\t%s\n", max, parts[1], parts[2]
            }
        }
    ' |
    fzf --prompt="Project> "
)

RC=$?

if [ "$RC" -eq 0 ] && [ -n "$SELECTED" ]; then
    PROJECT="${SELECTED#*$'\t'}"
    zeditor -e "$PROJECT"
fi
exit 0
